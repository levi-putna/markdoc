{
  "name": "markdoc",
  "productName": "MarkDoc",
  "version": "0.4.0",
  "description": "A native macOS Markdown editor built with Electron and Tiptap",
  "main": "./out/main/index.js",
  "author": "MarkDoc",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:quicklook": "bash macos/scripts/build-quicklook.sh",
    "build:icon": "bash scripts/compile-macos-icon.sh",
    "package": "yarn build && yarn build:icon && yarn build:quicklook && electron-builder --mac",
    "dist": "yarn package",
    "release": "yarn build && yarn build:icon && yarn build:quicklook && electron-builder --mac --publish always",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"tests/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:ai-live": "vitest run tests/integration/ai-gateway-live.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke": "vitest run && playwright test tests/e2e/smoke"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.16",
    "@ai-sdk/react": "^4.0.23",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@testing-library/dom": "^10.4.1",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-code-block": "^2.11.5",
    "@tiptap/extension-code-block-lowlight": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-mention": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@tiptap/suggestion": "^2.11.5",
    "ai": "^7.0.22",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "5",
    "docx": "^9.2.0",
    "dompurify": "^3.2.4",
    "electron-log": "^5.3.0",
    "electron-updater": "^6.8.9",
    "gray-matter": "^4.0.3",
    "hast-util-to-html": "^9.0.5",
    "highlight.js": "^11.11.1",
    "image-size": "^2.0.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.474.0",
    "mermaid": "^11.4.1",
    "minisearch": "^7.1.1",
    "motion": "^12.42.2",
    "nanoid": "^6.0.0",
    "react-simple-code-editor": "^0.14.1",
    "shiki": "^4.3.1",
    "simplemde": "^1.11.2",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tiptap-markdown": "^0.8.10",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/simplemde": "^1.11.11",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "prettier": "^3.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "com.markdoc.app",
    "productName": "MarkDoc",
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "cli/markdoc",
        "to": "cli/markdoc"
      },
      {
        "from": "build/Assets.car",
        "to": "Assets.car"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "levi-putna",
      "repo": "markdoc"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "signIgnore": [
        "Contents/PlugIns/MarkDocQuickLook.appex"
      ],
      "x64ArchFiles": "Contents/PlugIns/MarkDocQuickLook.appex/**",
      "extendInfo": {
        "CFBundleIconName": "MarkDoc",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Markdown Document",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": [
              "net.daringfireball.markdown"
            ],
            "CFBundleTypeExtensions": [
              "md",
              "markdown",
              "mdown",
              "mkd"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "net.daringfireball.markdown",
            "UTTypeDescription": "Markdown Document",
            "UTTypeConformsTo": [
              "public.plain-text"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "md",
                "markdown",
                "mdown",
                "mkd"
              ]
            }
          }
        ]
      }
    }
  }
}
